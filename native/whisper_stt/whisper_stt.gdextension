[configuration]

entry_symbol = "whisper_stt_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://native/whisper_stt/bin/libwhisper_stt.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/whisper_stt/bin/libwhisper_stt.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/whisper_stt/bin/libwhisper_stt.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/whisper_stt/bin/libwhisper_stt.windows.template_release.x86_64.dll"
android.release.arm64 = "res://native/whisper_stt/bin/libwhisper_stt.android.template_release.arm64.so"
android.debug.arm64 = "res://native/whisper_stt/bin/libwhisper_stt.android.template_release.arm64.so"
