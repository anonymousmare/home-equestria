+
+## LOCAL PATCH ONLY (not in the repo): a player build turns the developer tools on when an empty
+## file named dev_tools.txt sits next to the executable. Logged once so godot.log says which.
+static var _override_known := false
+static var _override_on := false
+static func _local_override() -> bool:
+	if not _override_known:
+		_override_known = true
+		var marker := OS.get_executable_path().get_base_dir().path_join("dev_tools.txt")
+		_override_on = FileAccess.file_exists(marker)
+		if _override_on: print("[dev] developer tools ON by %s (player build)" % marker)
+		else: print("[dev] developer tools OFF: player build. Create an empty dev_tools.txt next to the .exe to turn them on.")
+	return _override_on
 
 
